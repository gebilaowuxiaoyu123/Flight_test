    <model name="depth_wall">
      <static>true</static>
      <pose>4 0 3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 6 6</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 6 6</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.3 0.2 1</ambient>
            <diffuse>0.8 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  
    <!-- 演示用第三人称跟拍相机（由 scripts/cam_follow.py 每帧 set_pose 移动） -->
    <model name="cam_third">
      <static>true</static>
      <pose>-2.5 -5.5 2.6 0 0.32 0.95</pose>
      <link name="link">
        <sensor name="third_cam" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <camera>
            <horizontal_fov>1.02</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>200</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>25</update_rate>
          <visualize>false</visualize>
        </sensor>
      </link>
    </model>

    <!-- 演示用俯视跟拍相机（机体正上方朝下） -->
    <model name="cam_top">
      <static>true</static>
      <pose>0 0 4.0 0 1.5707 0</pose>
      <link name="link">
        <sensor name="top_cam" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <camera>
            <horizontal_fov>1.20</horizontal_fov>
            <image>
              <width>640</width>
              <height>360</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>200</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>25</update_rate>
          <visualize>false</visualize>
        </sensor>
      </link>
    </model>
</world>
