# =============================================================================
# flight_project 版本锁定
#
# 升级原则：只改这个文件，然后运行 scripts/verify.sh 做回归检查。
# 详细升级步骤见 docs/08-upgrade.md。
# =============================================================================

# --- OS / ROS 2 ---
UBUNTU_CODENAME=jammy
ROS_DISTRO=humble

# --- PX4 ---
PX4_TAG=v1.16.2
PX4_MSGS_BRANCH=release/1.16

# --- Gazebo ---
GZ_VERSION=harmonic
GZ_PKG=gz-harmonic

# --- ROS 2 <-> Gazebo 桥 ---
# Humble 没有 Harmonic 的二进制包，需要按 GZ_VERSION 源码编译。
ROS_GZ_BRANCH=humble

# --- Micro-XRCE-DDS Agent ---
XRCE_AGENT_REPO=https://github.com/eProsima/Micro-XRCE-DDS-Agent.git
XRCE_AGENT_REF=master

# --- 构建 ---
# 当前机器 30GB RAM 且没有 swap，默认限制为 8。
# 扩容后可设 JOBS=auto，或直接 JOBS=16。
JOBS=${JOBS:-8}

# 可选：把大型构建目录迁到大盘时设置。
# 留空则构建目录位于项目内。
WORKSPACE_ROOT=${WORKSPACE_ROOT:-}
